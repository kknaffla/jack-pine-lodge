# Copy to feed/feed.env (gitignored) and fill in. Kevin types the password himself; it never goes in chat or git.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...). Never the secret / service_role key: the feed refuses it.
SUPABASE_KEY=sb_publishable_xxx
# The app's feed login (members.role = 'feed'), made by Kevin in Supabase → Authentication → Users.
FEED_EMAIL=feed-login@example.com
FEED_PASSWORD=
# Where the bookkeeping tool lives (default ~/Bookkeeping).
BOOKKEEPING=~/Bookkeeping
# Nightly copy of everything entered in the app (dated subfolders). Kevin confirms the folder.
BACKUP_DIR=~/Library/CloudStorage/OneDrive-Personal/Claude Working Folder/Jack Pine Lodge App Backups
